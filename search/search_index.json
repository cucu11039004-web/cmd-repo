{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u5e38\u7528\u547d\u4ee4","text":""},{"location":"#linux","title":"Linux","text":"<pre><code>ls -la\n</code></pre> <pre><code>find . -type f -name '*.md'\n</code></pre> <pre><code>lsof -i :8000\n</code></pre> <pre><code>curl -I https://example.com\n</code></pre>"},{"location":"#git","title":"Git","text":"<pre><code>git status\n</code></pre> <pre><code>git diff\n</code></pre> <pre><code>git log --oneline -10\n</code></pre> <pre><code>git push\n</code></pre>"},{"location":"#python","title":"Python \u73af\u5883","text":"<pre><code>source .venv/bin/activate\n</code></pre> <pre><code>conda activate demo\n</code></pre> <pre><code>uv sync\n</code></pre> <pre><code>uv run python --version\n</code></pre>"},{"location":"git/","title":"Git","text":"<p>\u5728 Git \u4ed3\u5e93\u76ee\u5f55\u5185\u6267\u884c\u8fd9\u4e9b\u547d\u4ee4\u3002</p>"},{"location":"git/#git-status","title":"\u67e5\u770b\u5f53\u524d\u6709\u54ea\u4e9b\u6539\u52a8","text":"<pre><code>git status\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u67e5\u770b\u5f53\u524d\u5206\u652f\uff0c\u4ee5\u53ca\u5c1a\u672a\u63d0\u4ea4\u3001\u5df2\u6682\u5b58\u548c\u672a\u8ddf\u8e2a\u7684\u6587\u4ef6\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u51c6\u5907\u63d0\u4ea4\u7b14\u8bb0\u524d\uff0c\u5148\u786e\u8ba4\u8fd9\u6b21\u4f1a\u6d89\u53ca\u54ea\u4e9b\u6587\u4ef6\u3002</li> <li>\u6765\u6e90\uff1a\u547d\u4ee4\u901f\u67e5\u8868\u5efa\u7ad9\u793a\u4f8b\u3002</li> </ul>"},{"location":"git/#git-diff","title":"\u67e5\u770b\u5c1a\u672a\u6682\u5b58\u7684\u4fee\u6539","text":"<pre><code>git diff\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u663e\u793a\u5df2\u8ddf\u8e2a\u6587\u4ef6\u4e2d\u5c1a\u672a\u6682\u5b58\u7684\u4fee\u6539\uff1b\u67e5\u770b\u5df2\u6682\u5b58\u7684\u4fee\u6539\u7528 <code>git diff --staged</code>\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u63d0\u4ea4\u524d\u68c0\u67e5\u5177\u4f53\u6539\u4e86\u54ea\u4e9b\u5185\u5bb9\uff1b\u65b0\u5efa\u4e14\u672a\u8ddf\u8e2a\u7684\u6587\u4ef6\u4e0d\u4f1a\u51fa\u73b0\u5728\u8fd9\u91cc\u3002</li> <li>\u6765\u6e90\uff1aGit \u5b98\u65b9\u6587\u6863\uff1agit diff\u3002</li> </ul>"},{"location":"git/#git-log","title":"\u5feb\u901f\u56de\u770b\u6700\u8fd1\u7684\u63d0\u4ea4","text":"<pre><code>git log --oneline -10\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u6bcf\u884c\u663e\u793a\u4e00\u6761\u63d0\u4ea4\u7684\u7b80\u77ed\u7f16\u53f7\u548c\u8bf4\u660e\uff0c\u6700\u591a\u663e\u793a\u6700\u8fd1 10 \u6761\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u60f3\u77e5\u9053\u6700\u8fd1\u66f4\u65b0\u8fc7\u54ea\u4e9b\u7b14\u8bb0\uff0c\u6216\u5bfb\u627e\u67d0\u6b21\u4fee\u6539\u5bf9\u5e94\u7684\u63d0\u4ea4\u3002</li> <li>\u6765\u6e90\uff1a\u547d\u4ee4\u901f\u67e5\u8868\u5efa\u7ad9\u793a\u4f8b\u3002</li> </ul>"},{"location":"git/#git-switch","title":"\u521b\u5efa\u5e76\u5207\u6362\u5230\u65b0\u5206\u652f","text":"<pre><code>git switch -c feature/demo\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u4ece\u5f53\u524d\u63d0\u4ea4\u521b\u5efa\u65b0\u5206\u652f\u5e76\u5207\u6362\u8fc7\u53bb\uff1b\u628a <code>feature/demo</code> \u6362\u6210\u9700\u8981\u7684\u5206\u652f\u540d\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u5f00\u59cb\u4e00\u9879\u72ec\u7acb\u4fee\u6539\uff0c\u5e0c\u671b\u5728\u65b0\u5206\u652f\u4e0a\u4fdd\u5b58\u548c\u68c0\u67e5\u3002</li> <li>\u6765\u6e90\uff1aGit \u5b98\u65b9\u6587\u6863\uff1agit switch\u3002</li> </ul>"},{"location":"git/#git-add","title":"\u6682\u5b58\u6307\u5b9a\u6587\u4ef6","text":"<pre><code>git add docs/git.md\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u5c06\u6307\u5b9a\u6587\u4ef6\u5f53\u524d\u7684\u4fee\u6539\u653e\u5165\u6682\u5b58\u533a\uff1b\u628a\u8def\u5f84\u6362\u6210\u5b9e\u9645\u9700\u8981\u63d0\u4ea4\u7684\u6587\u4ef6\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u53ea\u60f3\u63d0\u4ea4\u90e8\u5206\u6587\u4ef6\uff0c\u5148\u9010\u4e2a\u9009\u62e9\uff0c\u518d\u7528 <code>git diff --staged</code> \u68c0\u67e5\u3002</li> <li>\u6765\u6e90\uff1aGit \u5b98\u65b9\u6587\u6863\uff1agit add\u3002</li> </ul>"},{"location":"git/#git-commit","title":"\u63d0\u4ea4\u5df2\u7ecf\u6682\u5b58\u7684\u6539\u52a8","text":"<pre><code>git commit -m \"docs: update commands\"\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u4e3a\u6682\u5b58\u533a\u91cc\u7684\u4fee\u6539\u521b\u5efa\u4e00\u6b21\u63d0\u4ea4\uff1b\u628a\u8bf4\u660e\u66ff\u6362\u6210\u8fd9\u6b21\u6539\u52a8\u7684\u5b9e\u9645\u5185\u5bb9\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u5b8c\u6210\u4e00\u7ec4\u4fee\u6539\u5e76\u68c0\u67e5\u540e\uff0c\u4fdd\u5b58\u4e00\u4e2a\u53ef\u4ee5\u56de\u770b\u7684\u7248\u672c\u3002</li> <li>\u6765\u6e90\uff1aGit \u5b98\u65b9\u6587\u6863\uff1agit commit\u3002</li> </ul>"},{"location":"git/#git-pull","title":"\u83b7\u53d6\u8fdc\u7aef\u66f4\u65b0\u5e76\u5feb\u8fdb\u5f53\u524d\u5206\u652f","text":"<pre><code>git pull --ff-only\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u83b7\u53d6\u4e0a\u6e38\u5206\u652f\u7684\u66f4\u65b0\uff0c\u53ea\u5728\u53ef\u4ee5\u5feb\u8fdb\u65f6\u66f4\u65b0\u5f53\u524d\u5206\u652f\uff1b\u5386\u53f2\u5206\u53c9\u65f6\u505c\u6b62\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u5f53\u524d\u5206\u652f\u5df2\u8bbe\u7f6e\u4e0a\u6e38\uff0c\u51c6\u5907\u540c\u6b65\u5176\u4ed6\u8bbe\u5907\u4e0a\u7684\u63d0\u4ea4\uff1b\u5386\u53f2\u5206\u53c9\u65f6\u5148\u68c0\u67e5\u63d0\u4ea4\u8bb0\u5f55\uff0c\u518d\u5904\u7406\u5408\u5e76\u6216\u53d8\u57fa\u3002</li> <li>\u6765\u6e90\uff1aGit \u5b98\u65b9\u6587\u6863\uff1agit pull\u3002</li> </ul>"},{"location":"git/#git-push","title":"\u63a8\u9001\u5f53\u524d\u5206\u652f\u7684\u63d0\u4ea4","text":"<pre><code>git push\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u6309\u4ed3\u5e93\u7684\u63a8\u9001\u914d\u7f6e\u5c06\u672c\u5730\u63d0\u4ea4\u53d1\u9001\u5230\u8fdc\u7aef\uff1b\u9996\u6b21\u63a8\u9001\u65b0\u5206\u652f\u53ef\u7528 <code>git push -u origin \u5206\u652f\u540d</code> \u8bbe\u7f6e\u4e0a\u6e38\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u5f53\u524d\u5206\u652f\u5df2\u6709\u4e0a\u6e38\uff0c\u5b8c\u6210\u63d0\u4ea4\u540e\u540c\u6b65\u5230\u8fdc\u7aef\uff1b\u672c\u4ed3\u5e93\u63a8\u9001 <code>main</code> \u4f1a\u89e6\u53d1\u7f51\u7ad9\u53d1\u5e03\u3002</li> <li>\u6765\u6e90\uff1aGit \u5b98\u65b9\u6587\u6863\uff1agit push\u3002</li> </ul>"},{"location":"inbox/","title":"\u6536\u96c6\u7bb1","text":"<p>\u8fd9\u91cc\u662f\u4e34\u65f6\u6536\u96c6\u533a\uff0c\u6bcf\u5468\u6e05\u7406\u5f52\u7c7b\u3002\u5f52\u6863\u540e\u4fdd\u7559\u672c\u9875\u6807\u9898\u548c\u8bf4\u660e\u3002\u8fd9\u91cc\u53ea\u8bb0\u5f55\u53ef\u4ee5\u516c\u5f00\u7684\u5185\u5bb9\u3002</p> <ul> <li>2026-09-30 python -m mkdocs build --strict\uff1b\u4f5c\u7528\uff1a\u6784\u5efa\u7ad9\u70b9\uff0c\u5e76\u5728\u51fa\u73b0\u8b66\u544a\u65f6\u505c\u6b62\uff1b\u573a\u666f\uff1a\u53d1\u5e03\u7b14\u8bb0\u524d\u68c0\u67e5\u914d\u7f6e\u548c\u6587\u6863\uff1b\u6765\u6e90\uff1a\u547d\u4ee4\u901f\u67e5\u8868\u9996\u6b21\u642d\u5efa</li> </ul>"},{"location":"linux/","title":"Linux","text":"<p>\u4ee5\u4e0b\u547d\u4ee4\u4e5f\u9002\u7528\u4e8e macOS \u7684 zsh / bash\u3002<code>rg</code> \u9700\u8981\u5b89\u88c5 ripgrep\uff1b\u90e8\u5206 Linux \u7cfb\u7edf\u9700\u8981\u5148\u5b89\u88c5 <code>lsof</code>\u3001<code>curl</code> \u6216 <code>ping</code>\u3002\u65e2\u6709\u793a\u4f8b\u7684\u6765\u6e90\u8868\u793a\u5efa\u7ad9\u6f14\u793a\uff0c\u4e0d\u4ee3\u8868\u4f60\u7684\u5b66\u4e60\u7ecf\u5386\u3002</p>"},{"location":"linux/#_1","title":"\u6587\u4ef6\u4e0e\u76ee\u5f55","text":""},{"location":"linux/#pwd","title":"\u67e5\u770b\u5f53\u524d\u6240\u5728\u76ee\u5f55","text":"<pre><code>pwd\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u663e\u793a\u5f53\u524d\u5de5\u4f5c\u76ee\u5f55\u7684\u5b8c\u6574\u8def\u5f84\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u8fd0\u884c\u9879\u76ee\u547d\u4ee4\u524d\uff0c\u786e\u8ba4\u7ec8\u7aef\u6240\u5728\u7684\u76ee\u5f55\u3002</li> <li>\u6765\u6e90\uff1aGNU Coreutils\uff1apwd\u3002</li> </ul>"},{"location":"linux/#ls-all","title":"\u67e5\u770b\u76ee\u5f55\u91cc\u7684\u5168\u90e8\u6587\u4ef6","text":"<pre><code>ls -la\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u4ee5\u8be6\u7ec6\u5217\u8868\u663e\u793a\u5f53\u524d\u76ee\u5f55\u5185\u5bb9\uff0c\u5305\u62ec\u4ee5\u70b9\u5f00\u5934\u7684\u9690\u85cf\u6587\u4ef6\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u60f3\u786e\u8ba4\u9879\u76ee\u91cc\u6709\u6ca1\u6709 <code>.gitignore</code>\uff0c\u6216\u67e5\u770b\u6587\u4ef6\u6743\u9650\u3002</li> <li>\u6765\u6e90\uff1a\u547d\u4ee4\u901f\u67e5\u8868\u5efa\u7ad9\u793a\u4f8b\u3002</li> </ul>"},{"location":"linux/#find-markdown","title":"\u6309\u540d\u79f0\u67e5\u627e Markdown \u6587\u4ef6","text":"<pre><code>find . -type f -name '*.md'\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u4ece\u5f53\u524d\u76ee\u5f55\u5411\u4e0b\u67e5\u627e\u6240\u6709\u4ee5 <code>.md</code> \u7ed3\u5c3e\u7684\u6587\u4ef6\uff1b\u5f15\u53f7\u8ba9\u901a\u914d\u7b26\u4ea4\u7ed9 <code>find</code> \u5904\u7406\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u6587\u6863\u5206\u6563\u5728\u591a\u4e2a\u5b50\u76ee\u5f55\uff0c\u4e0d\u77e5\u9053\u67d0\u7bc7\u7b14\u8bb0\u653e\u5728\u54ea\u91cc\u3002</li> <li>\u6765\u6e90\uff1a\u547d\u4ee4\u901f\u67e5\u8868\u5efa\u7ad9\u793a\u4f8b\u3002</li> </ul>"},{"location":"linux/#rg-text","title":"\u641c\u7d22\u9879\u76ee\u91cc\u7684\u6587\u672c","text":"<pre><code>rg '\u5173\u952e\u8bcd' .\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u9012\u5f52\u641c\u7d22\u5f53\u524d\u76ee\u5f55\u4e2d\u7684\u6587\u672c\uff0c\u663e\u793a\u5339\u914d\u7684\u6587\u4ef6\u548c\u5185\u5bb9\uff1b\u9ed8\u8ba4\u8df3\u8fc7\u9690\u85cf\u6587\u4ef6\u548c\u88ab\u5ffd\u7565\u7684\u6587\u4ef6\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u67e5\u627e\u67d0\u4e2a\u914d\u7f6e\u9879\u6216\u62a5\u9519\u4fe1\u606f\u51fa\u73b0\u5728\u54ea\u4e2a\u6587\u4ef6\u4e2d\uff1b\u628a <code>\u5173\u952e\u8bcd</code> \u6362\u6210\u8981\u641c\u7d22\u7684\u6587\u672c\uff0c\u641c\u7d22\u7eaf\u6587\u672c\u65f6\u53ef\u52a0 <code>-F</code>\u3002</li> <li>\u6765\u6e90\uff1aripgrep \u5b98\u65b9\u6307\u5357\u3002</li> </ul>"},{"location":"linux/#_2","title":"\u8fdb\u7a0b","text":""},{"location":"linux/#ps-all","title":"\u67e5\u770b\u6b63\u5728\u8fd0\u884c\u7684\u8fdb\u7a0b","text":"<pre><code>ps aux\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u5217\u51fa\u5f53\u524d\u53ef\u89c1\u7684\u8fdb\u7a0b\u53ca\u5176 PID\u3001CPU \u548c\u5185\u5b58\u4f7f\u7528\u60c5\u51b5\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u7a0b\u5e8f\u8fd0\u884c\u5f02\u5e38\uff0c\u60f3\u786e\u8ba4\u8fdb\u7a0b\u662f\u5426\u8fd8\u5728\u8fd0\u884c\uff0c\u6216\u67e5\u627e\u5360\u7528\u8d44\u6e90\u7684\u7a0b\u5e8f\u3002</li> <li>\u6765\u6e90\uff1aprocps-ng\uff1aps \u624b\u518c\u3002</li> </ul>"},{"location":"linux/#port-owner","title":"\u67e5\u770b\u8c01\u5360\u7528\u4e86\u67d0\u4e2a\u7aef\u53e3","text":"<pre><code>lsof -i :8000\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u5217\u51fa\u4f7f\u7528 8000 \u7aef\u53e3\u7684\u7f51\u7edc\u8fde\u63a5\u548c\u8fdb\u7a0b\uff0cPID \u662f\u8fdb\u7a0b\u7f16\u53f7\uff1b\u6ca1\u6709\u8f93\u51fa\u53ef\u80fd\u662f\u6ca1\u6709\u5339\u914d\u7ed3\u679c\u6216\u6743\u9650\u4e0d\u8db3\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u672c\u5730\u542f\u52a8\u670d\u52a1\u65f6\u62a5 <code>address already in use</code>\uff0c\u9700\u8981\u5148\u786e\u8ba4\u5360\u7528\u8005\u3002</li> <li>\u6765\u6e90\uff1a\u547d\u4ee4\u901f\u67e5\u8868\u5efa\u7ad9\u793a\u4f8b\u3002</li> </ul>"},{"location":"linux/#_3","title":"\u7f51\u7edc","text":""},{"location":"linux/#http-headers","title":"\u67e5\u770b\u7f51\u7ad9\u7684\u54cd\u5e94\u5934","text":"<pre><code>curl -I https://example.com\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u53d1\u9001 HEAD \u8bf7\u6c42\uff0c\u67e5\u770b HTTP \u72b6\u6001\u7801\u548c\u54cd\u5e94\u5934\uff0c\u4e0d\u4e0b\u8f7d\u5b8c\u6574\u9875\u9762\u6b63\u6587\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u68c0\u67e5\u7f51\u7ad9\u662f\u5426\u54cd\u5e94\uff0c\u6216\u67e5\u770b\u5b83\u662f\u5426\u8fd4\u56de\u91cd\u5b9a\u5411\uff1b\u90e8\u5206\u7f51\u7ad9\u4e0d\u652f\u6301 HEAD \u8bf7\u6c42\u3002</li> <li>\u6765\u6e90\uff1a\u547d\u4ee4\u901f\u67e5\u8868\u5efa\u7ad9\u793a\u4f8b\uff0c<code>example.com</code> \u662f\u6f14\u793a\u7528\u57df\u540d\u3002</li> </ul>"},{"location":"linux/#ping-host","title":"\u6d4b\u8bd5\u7f51\u7edc\u8fde\u901a\u6027","text":"<pre><code>ping -c 4 example.com\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u53d1\u9001 4 \u6b21 ICMP \u63a2\u6d4b\uff0c\u67e5\u770b\u54cd\u5e94\u5ef6\u8fdf\u548c\u4e22\u5305\u60c5\u51b5\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u521d\u6b65\u68c0\u67e5\u80fd\u5426\u5230\u8fbe\u67d0\u53f0\u4e3b\u673a\uff1b\u4e3b\u673a\u53ef\u80fd\u7981\u7528 ICMP\uff0c\u6ca1\u6709\u54cd\u5e94\u4e0d\u4e00\u5b9a\u4ee3\u8868\u7f51\u7ad9\u65e0\u6cd5\u8bbf\u95ee\u3002</li> <li>\u6765\u6e90\uff1aiputils\uff1aping \u624b\u518c\u3002</li> </ul>"},{"location":"python-env/","title":"Python \u73af\u5883","text":"<p>\u4ee5\u4e0b\u547d\u4ee4\u9002\u7528\u4e8e macOS / Linux \u7684 zsh \u6216 bash\uff0c\u5728\u9879\u76ee\u76ee\u5f55\u4e2d\u6267\u884c\u3002</p>"},{"location":"python-env/#venv","title":".venv","text":"<p>\u9700\u8981\u5df2\u5b89\u88c5 Python 3\u3002\u8fd9\u4e00\u7ec4\u7528 Python \u81ea\u5e26\u7684 <code>venv</code> \u521b\u5efa\u73af\u5883\uff0c\u518d\u7528 pip \u5b89\u88c5\u4f9d\u8d56\u3002</p>"},{"location":"python-env/#venv-create","title":"\u7ed9\u9879\u76ee\u521b\u5efa\u72ec\u7acb\u7684 Python \u73af\u5883","text":"<pre><code>python3 -m venv .venv\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u5728\u5f53\u524d\u76ee\u5f55\u521b\u5efa <code>.venv</code>\uff0c\u628a\u8fd9\u4e2a\u9879\u76ee\u7684 Python \u4f9d\u8d56\u4e0e\u7cfb\u7edf\u73af\u5883\u9694\u79bb\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u5f00\u59cb\u65b0\u9879\u76ee\uff0c\u9700\u8981\u5b89\u88c5\u4f9d\u8d56\uff0c\u53c8\u4e0d\u60f3\u5f71\u54cd\u5176\u4ed6\u9879\u76ee\u3002</li> <li>\u6765\u6e90\uff1a\u547d\u4ee4\u901f\u67e5\u8868\u5efa\u7ad9\u793a\u4f8b\u3002</li> </ul>"},{"location":"python-env/#venv-activate","title":"\u6fc0\u6d3b\u9879\u76ee\u7684\u865a\u62df\u73af\u5883","text":"<pre><code>source .venv/bin/activate\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u8ba9\u5f53\u524d\u7ec8\u7aef\u4f18\u5148\u4f7f\u7528 <code>.venv</code> \u91cc\u7684 Python \u548c\u5de5\u5177\uff1b\u6267\u884c <code>deactivate</code> \u53ef\u4ee5\u9000\u51fa\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u91cd\u65b0\u6253\u5f00\u7ec8\u7aef\u540e\uff0c\u9700\u8981\u7ee7\u7eed\u8fd0\u884c\u9879\u76ee\u6216\u5b89\u88c5\u4f9d\u8d56\u3002</li> <li>\u6765\u6e90\uff1a\u547d\u4ee4\u901f\u67e5\u8868\u5efa\u7ad9\u793a\u4f8b\u3002</li> </ul>"},{"location":"python-env/#venv-deactivate","title":"\u9000\u51fa\u5f53\u524d\u865a\u62df\u73af\u5883","text":"<pre><code>deactivate\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u64a4\u9500\u5f53\u524d\u7ec8\u7aef\u7684\u865a\u62df\u73af\u5883\u6fc0\u6d3b\u72b6\u6001\uff0c\u4e0d\u5220\u9664 <code>.venv</code> \u6216\u5176\u4e2d\u7684\u4f9d\u8d56\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u5df2\u7ecf\u7528 <code>source .venv/bin/activate</code> \u6fc0\u6d3b\u73af\u5883\uff0c\u73b0\u5728\u8981\u5207\u56de\u539f\u6765\u7684\u7ec8\u7aef\u73af\u5883\u3002</li> <li>\u6765\u6e90\uff1aPython \u5b98\u65b9\u6587\u6863\uff1avenv\u3002</li> </ul>"},{"location":"python-env/#venv-install","title":"\u5b89\u88c5\u9879\u76ee\u5217\u51fa\u7684\u4f9d\u8d56","text":"<pre><code>python -m pip install -r requirements.txt\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u7528\u5f53\u524d Python \u5bf9\u5e94\u7684 pip \u5b89\u88c5\u4f9d\u8d56\u6587\u4ef6\u4e2d\u7684\u5305\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u9879\u76ee\u5b58\u5728 <code>requirements.txt</code>\uff0c\u521b\u5efa\u5e76\u6fc0\u6d3b <code>.venv</code> \u540e\uff0c\u9700\u8981\u51c6\u5907\u8fd0\u884c\u73af\u5883\u3002</li> <li>\u6765\u6e90\uff1aPython \u5b98\u65b9\u6587\u6863\uff1avenv\u3002</li> </ul>"},{"location":"python-env/#conda","title":"Conda","text":"<p>\u9700\u8981\u5df2\u5b89\u88c5 Conda\uff0c\u5e76\u5df2\u521d\u59cb\u5316\u5f53\u524d shell\u3002\u4ee5\u4e0b <code>demo</code> \u662f\u73af\u5883\u540d\u793a\u4f8b\uff1bPython 3.12 \u662f\u6307\u5b9a\u7248\u672c\u793a\u4f8b\uff0c\u53ef\u6309\u9879\u76ee\u8981\u6c42\u66ff\u6362\u3002</p>"},{"location":"python-env/#conda-create","title":"\u521b\u5efa\u6307\u5b9a Python \u7248\u672c\u7684\u73af\u5883","text":"<pre><code>conda create -n demo python=3.12\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u521b\u5efa\u540d\u4e3a <code>demo</code> \u7684\u72ec\u7acb\u73af\u5883\uff0c\u5e76\u5b89\u88c5 Python 3.12\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u9879\u76ee\u8981\u6c42\u7279\u5b9a Python \u7248\u672c\uff0c\u5e0c\u671b\u7528\u547d\u540d\u73af\u5883\u7ba1\u7406\u4f9d\u8d56\u3002</li> <li>\u6765\u6e90\uff1aConda \u5b98\u65b9\u6587\u6863\uff1a\u7ba1\u7406\u73af\u5883\u3002</li> </ul>"},{"location":"python-env/#conda-activate","title":"\u6fc0\u6d3b\u4e00\u4e2a Conda \u73af\u5883","text":"<pre><code>conda activate demo\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u8ba9\u5f53\u524d\u7ec8\u7aef\u4f7f\u7528 <code>demo</code> \u73af\u5883\u4e2d\u7684 Python \u548c\u5de5\u5177\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u73af\u5883\u5df2\u521b\u5efa\uff0c\u5f00\u59cb\u8fd0\u884c\u9879\u76ee\u6216\u5b89\u88c5\u4f9d\u8d56\uff1b\u628a <code>demo</code> \u6362\u6210\u5b9e\u9645\u73af\u5883\u540d\u3002</li> <li>\u6765\u6e90\uff1aConda \u5b98\u65b9\u6587\u6863\uff1a\u7ba1\u7406\u73af\u5883\u3002</li> </ul>"},{"location":"python-env/#conda-deactivate","title":"\u9000\u51fa\u5f53\u524d Conda \u73af\u5883","text":"<pre><code>conda deactivate\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u9000\u51fa\u5f53\u524d Conda \u6fc0\u6d3b\u5c42\uff0c\u6062\u590d\u4e4b\u524d\u7684\u73af\u5883\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u5b8c\u6210\u5f53\u524d\u73af\u5883\u7684\u5de5\u4f5c\u540e\u9000\u51fa\uff1b\u5982\u679c\u53ea\u60f3\u56de\u5230 <code>base</code>\uff0c\u53ef\u7528 <code>conda activate base</code>\u3002</li> <li>\u6765\u6e90\uff1aConda \u5b98\u65b9\u6587\u6863\uff1a\u7ba1\u7406\u73af\u5883\u3002</li> </ul>"},{"location":"python-env/#conda-list","title":"\u5217\u51fa\u5df2\u6709\u7684 Conda \u73af\u5883","text":"<pre><code>conda env list\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u663e\u793a\u5df2\u6709\u73af\u5883\u7684\u540d\u79f0\u548c\u4f4d\u7f6e\uff0c\u661f\u53f7\u6807\u51fa\u5f53\u524d\u6fc0\u6d3b\u7684\u73af\u5883\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u5fd8\u8bb0\u73af\u5883\u540d\uff0c\u6216\u60f3\u786e\u8ba4\u5f53\u524d\u6b63\u5728\u7528\u54ea\u4e2a\u73af\u5883\u3002</li> <li>\u6765\u6e90\uff1aConda \u5b98\u65b9\u6587\u6863\uff1a\u7ba1\u7406\u73af\u5883\u3002</li> </ul>"},{"location":"python-env/#uv","title":"uv","text":"<p>\u9700\u8981\u5df2\u5b89\u88c5 uv\u3002\u4ee5\u4e0b\u4f7f\u7528 uv \u7684\u9879\u76ee\u6a21\u5f0f\uff1a\u5148\u521d\u59cb\u5316\u6216\u8fdb\u5165\u5df2\u6709\u7684 uv \u9879\u76ee\uff0c\u4f9d\u8d56\u8bb0\u5f55\u5728 <code>pyproject.toml</code>\uff0c\u9879\u76ee\u73af\u5883\u9ed8\u8ba4\u4f4d\u4e8e <code>.venv</code>\u3002uv \u4f1a\u5728\u540c\u6b65\u6216\u8fd0\u884c\u65f6\u7ba1\u7406\u73af\u5883\uff0c\u901a\u5e38\u4e0d\u7528\u624b\u52a8\u6fc0\u6d3b\u3002</p>"},{"location":"python-env/#uv-init","title":"\u521d\u59cb\u5316\u4e00\u4e2a uv \u9879\u76ee","text":"<pre><code>uv init\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u5728\u5f53\u524d\u76ee\u5f55\u521d\u59cb\u5316\u9879\u76ee\uff0c\u751f\u6210 <code>pyproject.toml</code> \u7b49\u9879\u76ee\u6587\u4ef6\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u5f00\u59cb\u4e00\u4e2a\u7531 uv \u7ba1\u7406\u7684\u65b0\u9879\u76ee\uff0c\u5728\u51c6\u5907\u597d\u7684\u9879\u76ee\u76ee\u5f55\u4e2d\u6267\u884c\u3002</li> <li>\u6765\u6e90\uff1auv \u5b98\u65b9\u6587\u6863\uff1a\u9879\u76ee\u6307\u5357\u3002</li> </ul>"},{"location":"python-env/#uv-add","title":"\u6dfb\u52a0\u9879\u76ee\u4f9d\u8d56","text":"<pre><code>uv add requests\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u5c06 <code>requests</code> \u52a0\u5165\u9879\u76ee\u4f9d\u8d56\uff0c\u5e76\u66f4\u65b0\u9501\u6587\u4ef6\u548c\u9879\u76ee\u73af\u5883\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u5df2\u6709 uv \u9879\u76ee\u9700\u8981\u4f7f\u7528\u65b0\u7684\u5e93\uff1b\u628a <code>requests</code> \u6362\u6210\u5b9e\u9645\u5305\u540d\u3002</li> <li>\u6765\u6e90\uff1auv \u5b98\u65b9\u6587\u6863\uff1a\u9879\u76ee\u6307\u5357\u3002</li> </ul>"},{"location":"python-env/#uv-sync","title":"\u540c\u6b65 uv \u9879\u76ee\u7684\u73af\u5883","text":"<pre><code>uv sync\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u6839\u636e\u9879\u76ee\u4f9d\u8d56\u4e0e\u9501\u6587\u4ef6\u540c\u6b65 <code>.venv</code>\uff0c\u4e0d\u5b58\u5728\u65f6\u81ea\u52a8\u521b\u5efa\uff1b\u9ed8\u8ba4\u79fb\u9664\u672a\u58f0\u660e\u7684\u989d\u5916\u5305\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u8fdb\u5165\u5df2\u6709 uv \u9879\u76ee\uff0c\u6216\u9879\u76ee\u4f9d\u8d56\u53d1\u751f\u53d8\u5316\uff0c\u9700\u8981\u51c6\u5907\u5bf9\u5e94\u7684\u73af\u5883\u3002</li> <li>\u6765\u6e90\uff1auv \u5b98\u65b9\u6587\u6863\uff1auv sync\u3002</li> </ul>"},{"location":"python-env/#uv-run","title":"\u7528\u9879\u76ee\u73af\u5883\u8fd0\u884c Python","text":"<pre><code>uv run python --version\n</code></pre> <ul> <li>\u4f5c\u7528\uff1a\u540c\u6b65\u9879\u76ee\u73af\u5883\u540e\uff0c\u5728\u5176\u4e2d\u8fd0\u884c Python \u5e76\u663e\u793a\u7248\u672c\u3002</li> <li>\u9047\u5230\u573a\u666f\uff1a\u5df2\u6709 uv \u9879\u76ee\uff0c\u4e0d\u60f3\u624b\u52a8\u6fc0\u6d3b\u73af\u5883\uff1b\u8fd0\u884c\u811a\u672c\u65f6\u53ef\u6539\u7528 <code>uv run python \u811a\u672c\u540d.py</code>\u3002</li> <li>\u6765\u6e90\uff1auv \u5b98\u65b9\u6587\u6863\uff1a\u8fd0\u884c\u547d\u4ee4\u3002</li> </ul>"}]}